type = theme
name = Tailwind css
description = A custom Backdrop CMS front-end theme powered by Tailwind CSS v3.
backdrop = 1.x
version = BACKDROP_VERSION

; Add theme CSS files
stylesheets[all][] = css/tailwindcss.min.css
stylesheets[all][] = css/style.min.css

scripts[] = js/script.js

; مصفوفة إعدادات الثيم الافتراضية
settings[site_background] = ""
settings[toggle_dark_mode] = 1
settings[toggle_breadcrumb] = 1
settings[hide_home_breadcrumb] = 0